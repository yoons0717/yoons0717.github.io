---
import { getProjects } from '../lib/posts';

interface Props {
	active?: string;
}

const { active } = Astro.props;
const projects = await getProjects();
---

<aside class="sidebar">
	<details open>
		<summary>프로젝트</summary>
		<nav>
			<a href="/blog" class:list={['all', { active: !active }]}>전체 글</a>
			<ul>
				{
					projects.map((p) => (
						<li>
							<a href={`/blog/${p.slug}/`} class:list={{ active: p.slug === active }}>
								<span class="name">{p.slug.replace(/-/g, ' ')}</span>
								<span class="count">{p.count}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</details>
</aside>

<style>
	.sidebar {
		font-size: 0.92em;
	}
	details {
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.4em 0.8em;
	}
	summary {
		cursor: pointer;
		color: var(--text-muted);
		font-size: 0.82em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.3em 0;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	nav {
		margin-top: 0.4em;
	}
	.all {
		display: block;
		padding: 0.35em 0;
		color: var(--text-muted);
	}
	ul {
		list-style: none;
		margin: 0.3em 0 0;
		padding: 0.3em 0 0;
		border-top: 1px solid var(--border);
	}
	li a {
		display: flex;
		justify-content: space-between;
		gap: 0.6em;
		padding: 0.35em 0;
		color: var(--text-muted);
	}
	.name {
		text-transform: capitalize;
	}
	.count {
		color: var(--text-muted);
		font-size: 0.85em;
		font-variant-numeric: tabular-nums;
	}
	a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	a.active {
		color: var(--heading);
		font-weight: 700;
	}
	@media (max-width: 860px) {
		.sidebar {
			margin-bottom: 2em;
		}
		details:not([open]) {
			padding-bottom: 0.4em;
		}
	}
</style>
