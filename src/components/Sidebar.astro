---
import { getProjects } from '../lib/posts';

interface Props {
	active?: string;
}

const { active } = Astro.props;
const projects = await getProjects();
---

<nav class="sidebar" aria-label="프로젝트">
	<div class="label">PROJECTS</div>
	<ul>
		<li>
			<a href="/blog" aria-current={active ? undefined : 'page'}>
				<span class="name">전체 글</span>
			</a>
		</li>
		{
			projects.map((p) => (
				<li>
					<a href={`/blog/${p.slug}/`} aria-current={p.slug === active ? 'page' : undefined}>
						<span class="name">{p.slug.replace(/-/g, ' ')}</span>
						<span class="count">{p.count}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.label {
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		color: var(--text-muted);
		margin-bottom: 0.85rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li a {
		display: flex;
		justify-content: space-between;
		gap: 0.6rem;
		padding: 0.32rem 0 0.32rem 0.7rem;
		border-left: 2px solid transparent;
		color: var(--text-muted);
		font-size: 0.88rem;
	}
	.name {
		text-transform: capitalize;
	}
	li a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	li a[aria-current] {
		border-left-color: var(--accent);
		color: var(--heading);
		font-weight: 700;
	}
	.count {
		font-size: 0.78rem;
		color: var(--text-muted);
		font-weight: 400;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 860px) {
		.sidebar {
			margin-bottom: 2em;
			padding-bottom: 1.2em;
			border-bottom: 1px solid var(--border);
		}
	}
</style>
