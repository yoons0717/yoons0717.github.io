---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, GISCUS } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	prev?: CollectionEntry<'blog'>;
	next?: CollectionEntry<'blog'>;
	headings?: { depth: number; slug: string; text: string }[];
};

const { title, description, pubDate, updatedDate, tags, prev, next, headings } = Astro.props;
const toc = (headings ?? []).filter((h) => h.depth === 2);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<h1>{title}</h1>
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									(수정: <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</div>
					{
						tags.length > 0 && (
							<div class="tags">
								{tags.map((tag) => (
									<a href={`/tags/${tag}/`}>#{tag}</a>
								))}
							</div>
						)
					}
				</header>

				{
					toc.length >= 3 && (
						<nav class="toc" aria-label="목차">
							<span class="toc-label">목차</span>
							<ol>
								{toc.map((h) => (
									<li>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
						</nav>
					)
				}

				<div class="prose">
					<slot />
				</div>
			</article>

			{
				(prev || next) && (
					<nav class="series-nav">
						{prev ? (
							<a class="series-nav-link prev" href={`/blog/${prev.id}/`}>
								<span class="dir">← 이전</span>
								<span class="t">{prev.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{next ? (
							<a class="series-nav-link next" href={`/blog/${next.id}/`}>
								<span class="dir">다음 →</span>
								<span class="t">{next.data.title}</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				)
			}

			<section class="comments">
				<h2>댓글</h2>
				<div id="giscus-container"></div>
				<script is:inline define:vars={{ GISCUS }}>
					(function () {
						var theme =
							document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
						var s = document.createElement('script');
						s.src = 'https://giscus.app/client.js';
						s.setAttribute('data-repo', GISCUS.repo);
						s.setAttribute('data-repo-id', GISCUS.repoId);
						s.setAttribute('data-category', GISCUS.category);
						s.setAttribute('data-category-id', GISCUS.categoryId);
						s.setAttribute('data-mapping', 'pathname');
						s.setAttribute('data-strict', '1');
						s.setAttribute('data-reactions-enabled', '1');
						s.setAttribute('data-emit-metadata', '0');
						s.setAttribute('data-input-position', 'top');
						s.setAttribute('data-theme', theme);
						s.setAttribute('data-lang', 'ko');
						s.crossOrigin = 'anonymous';
						s.async = true;
						document.getElementById('giscus-container').appendChild(s);

						document.addEventListener('theme-change', function (e) {
							var t = e.detail === 'dark' ? 'dark' : 'light';
							var frame = document.querySelector('iframe.giscus-frame');
							if (frame)
								frame.contentWindow.postMessage(
									{ giscus: { setConfig: { theme: t } } },
									'https://giscus.app',
								);
						});
					})();
				</script>
			</section>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				var imgs = document.querySelectorAll('.prose img');
				if (!imgs.length) return;
				function openLightbox(src, alt) {
					var box = document.createElement('div');
					box.className = 'zoom-lightbox';
					var big = document.createElement('img');
					big.src = src;
					big.alt = alt || '';
					box.appendChild(big);
					function close() {
						box.remove();
						document.removeEventListener('keydown', onKey);
					}
					function onKey(e) {
						if (e.key === 'Escape') close();
					}
					box.addEventListener('click', close);
					document.addEventListener('keydown', onKey);
					document.body.appendChild(box);
				}
				imgs.forEach(function (img) {
					img.style.cursor = 'zoom-in';
					img.setAttribute('role', 'button');
					img.addEventListener('click', function () {
						openLightbox(img.currentSrc || img.src, img.alt);
					});
				});
			})();
		</script>
	</body>
</html>

<style>
	.post-header {
		margin-bottom: 2em;
		padding-bottom: 1.5em;
		border-bottom: 1px solid var(--border);
	}
	.post-header h1 {
		margin-bottom: 0.3em;
	}
	.meta {
		color: var(--text-muted);
		font-size: 0.95em;
	}
	.updated {
		margin-left: 0.5em;
	}
	.tags {
		margin-top: 0.6em;
		display: flex;
		gap: 0.6em;
		flex-wrap: wrap;
		font-size: 0.9em;
	}
	.tags a {
		color: var(--text-muted);
	}
	.tags a:hover {
		color: var(--accent);
	}
	.toc {
		margin: 0 0 2.5em;
		padding: 1em 1.2em;
		border: 1px solid var(--border);
		border-radius: 4px;
		font-size: 0.92em;
	}
	.toc-label {
		color: var(--text-muted);
		font-size: 0.8em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.toc ol {
		margin: 0.5em 0 0;
		padding-left: 1.5em;
	}
	.toc li {
		margin: 0.3em 0;
	}
	.toc a {
		color: var(--text-muted);
	}
	.toc a:hover {
		color: var(--accent);
	}
	.prose :global(h2) {
		margin-top: 1.6em;
	}
	.prose :global(img) {
		display: block;
		margin: 1.5em auto;
	}
	.comments {
		margin-top: 4em;
		padding-top: 2em;
		border-top: 1px solid var(--border);
	}
	.comments h2::before {
		content: '$ ';
		color: var(--accent);
	}

	.series-nav {
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid var(--border);
		display: flex;
		gap: 1em;
		justify-content: space-between;
	}
	.series-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		max-width: 48%;
		font-size: 0.9em;
	}
	.series-nav-link.next {
		text-align: right;
		margin-left: auto;
	}
	.series-nav-link .dir {
		color: var(--text-muted);
	}
	.series-nav-link .t {
		color: var(--accent);
	}
	.series-nav-link:hover .t {
		text-decoration: underline;
	}
	:global(.zoom-lightbox) {
		position: fixed;
		inset: 0;
		z-index: 999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3vmin;
		background: rgba(0, 0, 0, 0.72);
		cursor: zoom-out;
	}
	:global(.zoom-lightbox img) {
		max-width: 96vw;
		max-height: 92vh;
		width: auto;
		height: auto;
		background: #ffffff;
		border-radius: 6px;
		box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
	}
</style>
